# Runtime configuration. Supply production values through Dockhand.
BCORDES_IMAGE=ghcr.io/bc-solutions-coder/bcordes:sha-REPLACE_WITH_TESTED_FULL_COMMIT
BCORDES_DOMAIN=bcordes.dev
BFF_APP_ID=bcordes
# Public alternative: https://api.wallow.dev
BFF_API_BASE_URL=http://wallow-api:8080
# Use https://auth.wallow.dev only if it matches the discovery issuer.
OIDC_ISSUER=https://REPLACE_WITH_VERIFIED_ISSUER
# Discovery is configured separately from BFF_API_BASE_URL.
OIDC_METADATA_URL=http://wallow-api:8080/.well-known/openid-configuration
OIDC_CLIENT_ID=REPLACE_WITH_DEVELOPER_CLIENT_ID
OIDC_CLIENT_SECRET=REPLACE_WITH_DEVELOPER_SECRET
OIDC_SCOPES=openid profile email offline_access inquiries.read inquiries.write notifications.read notifications.write
OIDC_REDIRECT_URI=https://bcordes.dev/bff/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://bcordes.dev/
# SDK names, even when Wallow calls these service-account credentials.
OIDC_SERVICE_CLIENT_ID=REPLACE_WITH_SERVICE_CLIENT_ID
OIDC_SERVICE_CLIENT_SECRET=REPLACE_WITH_SERVICE_SECRET
OIDC_SERVICE_SCOPES=inquiries.write
COOKIE_PASSWORD=REPLACE_WITH_STABLE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=86400
VALKEY_PASSWORD=REPLACE_WITH_SESSION_STORE_PASSWORD
REDIS_URL=redis://default:REPLACE_WITH_URL_ENCODED_SESSION_STORE_PASSWORD@bcordes-session-store:6379
WALLOW_TRUSTED_PROXIES=private
# NODE_AUTH_TOKEN is build/install-only. Never supply it to the web container.
