{
  "name": "bcordes-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter bcordes dev",
    "build": "pnpm --filter bcordes build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "node --max-old-space-size=8192 ./node_modules/eslint/bin/eslint.js",
    "format": "prettier --write .",
    "check": "prettier --write . && pnpm lint --fix",
    "storybook": "pnpm --filter bcordes storybook",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@bcordes/config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
