{
  "name": "bcordes-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter bcordes dev",
    "build": "pnpm --filter bcordes build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxfmt && pnpm lint --fix",
    "storybook": "pnpm --filter bcordes storybook",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --type-aware --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,md,yml,yaml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "devDependencies": {
    "@bcordes/config": "workspace:*",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint-plugin-import-x": "4.17.1",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
