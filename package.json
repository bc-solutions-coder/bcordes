{
  "name": "bcordes-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter bcordes dev",
    "build": "pnpm --filter bcordes build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint",
    "format": "prettier --write .",
    "check": "prettier --write . && eslint --fix",
    "storybook": "pnpm --filter bcordes storybook",
    "prepare": "husky"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/react-router": "1.168.3",
      "@tanstack/router-core": "1.168.3",
      "seroval": ">=1.4.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@tanstack/eslint-config": "^0.4.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
